<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep the local Supabase session on this device only. -->
        <exclude domain="sharedpref" path="tribe_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- A transferred backup must not carry reusable authentication tokens. -->
        <exclude domain="sharedpref" path="tribe_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
